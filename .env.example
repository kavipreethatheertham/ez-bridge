# Copy this file to .env and paste your own values. .env is never committed: .gitignore lists it.
# Supabase dashboard > Connect > "Get API details" (or Settings > API Keys).
# Use the Publishable key (sb_publishable_...). Never put the secret key here.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
